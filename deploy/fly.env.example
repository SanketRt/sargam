# Deployment-specific configuration. Copy to deploy/fly.env (git-ignored) and
# apply with:
#
#   set -a; . deploy/fly.env; set +a
#   flyctl secrets set \
#     SARGAM_PUBLIC_URL="$SARGAM_PUBLIC_URL" \
#     SARGAM_BASE_PATH="$SARGAM_BASE_PATH" \
#     SARGAM_SECRET="$SARGAM_SECRET" \
#     SARGAM_KEY_SECRET="$SARGAM_KEY_SECRET" \
#     GOOGLE_CLIENT_ID="$GOOGLE_CLIENT_ID" \
#     GOOGLE_CLIENT_SECRET="$GOOGLE_CLIENT_SECRET"
#
# None of these belong in the repository: the first two identify a particular
# site, and the rest are credentials.

# What the browser sees, with no trailing slash.
SARGAM_PUBLIC_URL=https://example.com

# The path the reverse proxy keeps and the app never receives. Empty if the
# app is served at the root of its own domain.
SARGAM_BASE_PATH=/projects/sargam

# Session cookie signing key.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SARGAM_SECRET=

# Master key for sealing each account's API credential. Losing this does not
# lose anyone's memoir; it makes stored API keys undecryptable, and they paste
# a new one.
#   python -c 'from sargam import vault; print(vault.generate())'
SARGAM_KEY_SECRET=

# Google OAuth 2.0 client (Web application). The authorised redirect URI is
# SARGAM_PUBLIC_URL + SARGAM_BASE_PATH + /auth/callback, exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
