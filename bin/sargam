#!/usr/bin/env python3
"""Entry point.

Works from a checkout with no install. Put it on your PATH:

    ln -s "$PWD/bin/sargam" ~/.local/bin/sargam
"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "src"))

from sargam.cli import main

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        sys.exit(130)
